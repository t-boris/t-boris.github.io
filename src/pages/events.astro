---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs/promises';
import path from 'path';

// Load active events from new data structure
let activeEvents: any[] = [];
let trustedSources: Record<string, any> = {};
let lastUpdate = 'No data yet';

try {
	const activeEventsPath = path.join(process.cwd(), 'public/events-data/active-events.json');
	const trustedSourcesPath = path.join(process.cwd(), 'public/events-data/trusted-sources.json');

	// Load active events
	const activeEventsContent = await fs.readFile(activeEventsPath, 'utf-8');
	const activeEventsData = JSON.parse(activeEventsContent);
	activeEvents = Object.values(activeEventsData);

	// Load trusted sources
	try {
		const trustedSourcesContent = await fs.readFile(trustedSourcesPath, 'utf-8');
		trustedSources = JSON.parse(trustedSourcesContent);
	} catch (e) {
		console.log('No trusted sources file yet');
	}

	// Find last update
	if (activeEvents.length > 0) {
		const dates = activeEvents.map(e => e.found_date).filter(Boolean);
		if (dates.length > 0) {
			lastUpdate = dates.sort().reverse()[0];
		}
	}
} catch (error) {
	console.error('Failed to load events data:', error);
}

// Sort events by date
activeEvents.sort((a, b) => {
	const dateA = new Date(a.event_date);
	const dateB = new Date(b.event_date);
	return dateA.getTime() - dateB.getTime();
});

// Get unique dates for calendar
const eventDates = [...new Set(activeEvents.map(e => e.event_date))].sort();

// Build calendar data for current month
const today = new Date();
const currentMonth = today.getMonth();
const currentYear = today.getFullYear();

// Load ALL snapshot files to build calendar
const snapshotsByDate = {};
try {
	const eventsDataDir = path.join(process.cwd(), 'public/events-data');
	const files = await fs.readdir(eventsDataDir);

	// Find all YYYY-MM-DD.json files
	const snapshotFiles = files.filter(f => /^\d{4}-\d{2}-\d{2}\.json$/.test(f));

	for (const file of snapshotFiles) {
		const dateStr = file.replace('.json', '');
		const filePath = path.join(eventsDataDir, file);
		try {
			const content = await fs.readFile(filePath, 'utf-8');
			const data = JSON.parse(content);
			// Count events in this snapshot
			snapshotsByDate[dateStr] = Object.keys(data).length;
		} catch (err) {
			console.error(`Failed to load snapshot ${file}:`, err);
		}
	}
} catch (err) {
	console.error('Failed to load snapshots:', err);
}

// Get events grouped by date (for future events)
const eventsByDate = {};
activeEvents.forEach(event => {
	if (!eventsByDate[event.event_date]) {
		eventsByDate[event.event_date] = 0;
	}
	eventsByDate[event.event_date]++;
});

// Merge snapshots and active events for calendar
const calendarEventCounts = { ...snapshotsByDate };
Object.keys(eventsByDate).forEach(date => {
	calendarEventCounts[date] = (calendarEventCounts[date] || 0) + eventsByDate[date];
});

// Get events with coordinates for map
const eventsWithCoords = activeEvents.filter(e => e.lat && e.lng);

// Sort trusted sources by count
const sortedSources = Object.entries(trustedSources)
	.map(([domain, data]) => ({ domain, ...data }))
	.sort((a, b) => b.count - a.count)
	.slice(0, 10); // Top 10

// Get all unique categories
const allCategories = [...new Set(activeEvents.map(e => e.category).filter(Boolean))].sort();

// Get today's date string (YYYY-MM-DD)
const todayStr = today.toISOString().split('T')[0];

// Separate today's events and future events
const todayEvents = activeEvents.filter(e => e.event_date === todayStr);
const futureEvents = activeEvents.filter(e => e.event_date > todayStr);

const HOME_LAT = 42.3703;
const HOME_LNG = -87.9023;

// Google Maps API key from environment (optional - will be used when map is implemented)
const GOOGLE_MAPS_API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || '';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Events | ${SITE_TITLE}`} description="Daily aggregated local events and news" />
		<style>
			body {
				background: var(--bg, #020617);
			}

			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			.page-content {
				padding: 2rem;
			}

			.page-header {
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 2px solid rgba(201, 165, 123, 0.3);
				text-align: center;
			}

			.page-header h1 {
				color: rgb(var(--black));
				margin-bottom: 0.5rem;
				font-size: 2.5rem;
			}

			.page-header p {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			/* Google Maps - Full width */
			#map {
				width: 100%;
				height: 500px;
				margin-bottom: 0;
			}

			/* 3-column layout */
			.content-grid {
				display: grid;
				grid-template-columns: 280px 1fr 320px;
				gap: 2rem;
				align-items: start;
			}

			/* Left sidebar - Trusted Sources */
			.sidebar-left {
				position: sticky;
				top: 2rem;
			}

			.sources-panel {
				background: rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				border: 1px solid rgba(201, 165, 123, 0.2);
			}

			.sources-panel h2 {
				margin-top: 0;
				margin-bottom: 1rem;
				color: rgb(var(--black));
				font-size: 1.2rem;
			}

			.source-item {
				padding: 0.75rem 0;
				border-bottom: 1px solid rgba(201, 165, 123, 0.1);
			}

			.source-item:last-child {
				border-bottom: none;
			}

			.source-link {
				text-decoration: none;
				display: block;
				transition: transform 0.2s;
			}

			.source-link:hover {
				transform: translateX(4px);
			}

			.source-domain {
				font-weight: 600;
				color: rgb(var(--gray-dark));
				font-size: 0.85rem;
				transition: color 0.2s;
			}

			.source-link:hover .source-domain {
				color: var(--accent);
			}

			.source-count {
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 700;
			}

			/* Today's Events Section */
			.today-section {
				margin-bottom: 2rem;
				padding: 1.5rem;
				background: rgb(var(--gray-light));
				border-radius: 12px;
				border: 2px solid var(--accent);
			}

			.today-section h2 {
				margin-top: 0;
				margin-bottom: 1rem;
				color: var(--accent);
				font-size: 1.5rem;
			}

			.today-empty {
				color: rgb(var(--gray));
				font-style: italic;
				text-align: center;
				padding: 1rem;
			}

			/* Center - Events list */
			.events-content {
				min-height: 400px;
			}

			.category-filter {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 2rem;
				padding: 1rem;
				background: rgb(var(--gray-light));
				border-radius: 12px;
				border: 1px solid rgba(201, 165, 123, 0.2);
			}

			.category-filter button {
				padding: 0.5rem 1rem;
				border: 1px solid rgba(201, 165, 123, 0.3);
				background: transparent;
				color: rgb(var(--gray-dark));
				border-radius: 6px;
				cursor: pointer;
				font-size: 0.875rem;
				font-weight: 500;
				transition: all 0.2s ease;
			}

			.category-filter button:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			.category-filter button.active {
				background: var(--accent);
				color: white;
				border-color: var(--accent);
			}

			.event-card {
				border: 1px solid rgba(201, 165, 123, 0.2);
				padding: 1.5rem;
				margin-bottom: 1.5rem;
				border-radius: 12px;
				background: rgb(var(--gray-light));
				transition: all 0.3s ease;
			}

			.event-card:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 16px rgba(201, 165, 123, 0.3);
				transform: translateY(-2px);
			}

			.event-card.hidden {
				display: none;
			}

			.event-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.75rem;
			}

			.category-badge {
				display: inline-block;
				padding: 0.4rem 0.8rem;
				border-radius: 12px;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			.category-badge.Business {
				background-color: rgba(59, 130, 246, 0.15);
				color: #2563eb;
			}
			.category-badge.Manufacturing {
				background-color: rgba(139, 92, 246, 0.15);
				color: #7c3aed;
			}
			.category-badge.Community {
				background-color: rgba(16, 185, 129, 0.15);
				color: #059669;
			}
			.category-badge.Culture {
				background-color: rgba(236, 72, 153, 0.15);
				color: #db2777;
			}
			.category-badge.Sports {
				background-color: rgba(234, 88, 12, 0.15);
				color: #ea580c;
			}
			.category-badge.News {
				background-color: rgba(245, 158, 11, 0.15);
				color: #d97706;
			}
			.category-badge.Incidents {
				background-color: rgba(239, 68, 68, 0.15);
				color: #dc2626;
			}

			.event-date-badge {
				font-size: 0.75rem;
				color: rgb(var(--gray));
				font-weight: 600;
			}

			.event-title {
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
				font-size: 1.25rem;
			}

			.event-description {
				color: rgb(var(--gray-dark));
				margin-bottom: 1rem;
				line-height: 1.6;
			}

			.event-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.85rem;
			}

			.event-location {
				color: rgb(var(--gray));
			}

			.event-link {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}

			.event-link:hover {
				text-decoration: underline;
			}

			/* Right sidebar - Calendar */
			.sidebar-right {
				position: sticky;
				top: 2rem;
			}

			.calendar-panel {
				background: rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				border: 1px solid rgba(201, 165, 123, 0.2);
			}

			.calendar-panel h2 {
				margin-top: 0;
				margin-bottom: 0.5rem;
				color: rgb(var(--black));
				font-size: 1.2rem;
			}

			.calendar-nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1rem;
				padding: 0.5rem;
				background: var(--bg, #020617);
				border-radius: 6px;
			}

			.calendar-nav button {
				background: none;
				border: none;
				color: var(--accent);
				cursor: pointer;
				font-size: 1.2rem;
				padding: 0.25rem 0.5rem;
				transition: transform 0.2s;
			}

			.calendar-nav button:hover {
				transform: scale(1.2);
			}

			.calendar-month {
				color: rgb(var(--gray-dark));
				font-weight: 600;
				font-size: 0.9rem;
			}

			.calendar-grid {
				display: grid;
				grid-template-columns: repeat(7, 1fr);
				gap: 4px;
			}

			.calendar-day-header {
				text-align: center;
				font-size: 0.7rem;
				font-weight: 600;
				color: rgb(var(--gray));
				padding: 0.25rem;
				text-transform: uppercase;
			}

			.calendar-day {
				position: relative;
				aspect-ratio: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				background: var(--bg, #020617);
				border: 1px solid rgba(201, 165, 123, 0.2);
				border-radius: 4px;
				cursor: pointer;
				transition: all 0.2s;
				position: relative;
				user-select: none;
			}

			.calendar-day.empty {
				background: transparent;
				border-color: transparent;
				cursor: default;
			}

			.calendar-day.today {
				border-color: var(--accent);
				border-width: 2px;
			}

			.calendar-day.has-events {
				background: rgba(201, 165, 123, 0.1);
				cursor: pointer;
			}

			.calendar-day.has-snapshot {
				background: rgba(100, 200, 255, 0.15);
				cursor: pointer;
				border-color: rgba(100, 200, 255, 0.4);
			}

			.calendar-day.has-events:hover {
				background: var(--accent);
				transform: scale(1.05);
			}

			.calendar-day.has-snapshot:hover {
				background: rgba(100, 200, 255, 0.3);
				transform: scale(1.05);
				border-color: rgba(100, 200, 255, 0.6);
			}

			.calendar-day:not(.empty):not(.has-events):hover {
				background: rgba(201, 165, 123, 0.05);
			}

			.calendar-day-number {
				font-size: 0.75rem;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				pointer-events: none;
			}

			.calendar-day.has-events:hover .calendar-day-number,
			.calendar-day.has-snapshot:hover .calendar-day-number {
				color: white;
			}

			.calendar-day-badge {
				position: absolute;
				bottom: 2px;
				right: 2px;
				background: var(--accent);
				color: white;
				font-size: 0.6rem;
				border-radius: 50%;
				width: 14px;
				height: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: 700;
				pointer-events: none;
			}

			.calendar-day.has-snapshot .calendar-day-badge {
				background: rgba(100, 200, 255, 0.8);
			}

			.no-events {
				color: rgb(var(--gray));
				font-style: italic;
				text-align: center;
				padding: 2rem;
			}

			@media (max-width: 1200px) {
				.content-grid {
					grid-template-columns: 1fr;
				}

				.sidebar-left, .sidebar-right {
					position: relative;
					top: 0;
				}
			}
		</style>

		<script is:inline define:vars={{ eventsWithCoords, HOME_LAT, HOME_LNG, GOOGLE_MAPS_API_KEY }}>
			let map;
			let markers = [];

			// Error handler for Google Maps API errors
			window.gm_authFailure = function() {
				console.error('Google Maps authentication failed - check API key and billing');
				const mapEl = document.getElementById('map');
				if (mapEl) {
					mapEl.innerHTML = '<div style="display: flex; align-items: center; justify-content: center; height: 100%; background: rgb(var(--gray-light)); color: rgb(var(--gray)); border-radius: 12px; border: 2px solid rgba(201, 165, 123, 0.3); padding: 2rem; text-align: center;"><div><p style="color: rgb(var(--gray-dark)); font-weight: 600; margin-bottom: 0.5rem;">Google Maps Authentication Failed</p><p style="color: rgb(var(--gray)); font-size: 0.85rem;">Please enable Maps JavaScript API and billing in Google Cloud Console.</p></div></div>';
				}
			};

			// This function will be called by the Google Maps API callback
			window.initMap = function() {
				try {
					console.log('Initializing Google Maps...');
					console.log('Events with coords:', eventsWithCoords.length);

					// Initialize map centered on home
					map = new google.maps.Map(document.getElementById('map'), {
						center: { lat: HOME_LAT, lng: HOME_LNG },
						zoom: 14,  // Street level view
						mapTypeId: 'roadmap',
						styles: [
							// Dark background
							{
								featureType: 'all',
								elementType: 'geometry',
								stylers: [{ color: '#1a1a2e' }]
							},
							// Water
							{
								featureType: 'water',
								elementType: 'geometry',
								stylers: [{ color: '#0f3460' }]
							},
							// Roads - make them visible
							{
								featureType: 'road',
								elementType: 'geometry',
								stylers: [{ color: '#38414e' }]
							},
							{
								featureType: 'road',
								elementType: 'geometry.stroke',
								stylers: [{ color: '#212a37' }]
							},
							{
								featureType: 'road',
								elementType: 'labels.text.fill',
								stylers: [{ color: '#9ca5b3' }]
							},
							{
								featureType: 'road.highway',
								elementType: 'geometry',
								stylers: [{ color: '#746855' }]
							},
							{
								featureType: 'road.highway',
								elementType: 'geometry.stroke',
								stylers: [{ color: '#1f2835' }]
							},
							{
								featureType: 'road.highway',
								elementType: 'labels.text.fill',
								stylers: [{ color: '#f3d19c' }]
							},
							// Labels
							{
								featureType: 'all',
								elementType: 'labels.text.fill',
								stylers: [{ color: '#c9a57b' }]
							},
							{
								featureType: 'all',
								elementType: 'labels.text.stroke',
								stylers: [{ color: '#1a1a2e' }]
							},
							// Parks
							{
								featureType: 'poi.park',
								elementType: 'geometry',
								stylers: [{ color: '#263c3f' }]
							},
							{
								featureType: 'poi.park',
								elementType: 'labels.text.fill',
								stylers: [{ color: '#6b9a76' }]
							}
						]
					});

					console.log('Map initialized successfully');

					// Add home marker
					new google.maps.Marker({
						position: { lat: HOME_LAT, lng: HOME_LNG },
						map: map,
						title: 'Home',
						icon: {
							url: 'https://maps.google.com/mapfiles/ms/icons/blue-dot.png'
						}
					});

					// Add event markers
					eventsWithCoords.forEach(event => {
						const marker = new google.maps.Marker({
							position: { lat: event.lat, lng: event.lng },
							map: map,
							title: event.title,
							icon: getCategoryIcon(event.category)
						});

						const infoWindow = new google.maps.InfoWindow({
							content: `
								<div style="color: #333; max-width: 200px;">
									<h3 style="margin: 0 0 0.5rem 0; font-size: 1rem;">${event.title}</h3>
									<p style="margin: 0 0 0.5rem 0; font-size: 0.85rem;">${event.description}</p>
									<p style="margin: 0; font-size: 0.75rem; color: #666;">${event.event_date}</p>
								</div>
							`
						});

						marker.addListener('click', () => {
							infoWindow.open(map, marker);
						});

						markers.push(marker);
					});

					console.log(`Added ${markers.length} event markers to map`);
				} catch (error) {
					console.error('Error initializing map:', error);
					const mapEl = document.getElementById('map');
					if (mapEl) {
						mapEl.innerHTML = '<div style="display: flex; align-items: center; justify-content: center; height: 100%; background: rgb(var(--gray-light)); color: rgb(var(--gray)); border-radius: 12px; border: 2px solid rgba(201, 165, 123, 0.3);"><p>Error initializing map: ' + error.message + '</p></div>';
					}
				}
			};

			function getCategoryIcon(category) {
				const colors = {
					'Business': 'red',
					'Manufacturing': 'purple',
					'Community': 'green',
					'Culture': 'pink',
					'Sports': 'orange',
					'News': 'yellow',
					'Incidents': 'red'
				};
				const color = colors[category] || 'red';
				return `https://maps.google.com/mapfiles/ms/icons/${color}-dot.png`;
			}

			// Load Google Maps API dynamically if API key is available
			if (GOOGLE_MAPS_API_KEY) {
				console.log('Loading Google Maps API...');
				const script = document.createElement('script');
				script.src = `https://maps.googleapis.com/maps/api/js?key=${GOOGLE_MAPS_API_KEY}&callback=initMap`;
				script.async = true;
				script.defer = true;
				script.onerror = function() {
					console.error('Failed to load Google Maps API script');
					const mapEl = document.getElementById('map');
					if (mapEl) {
						mapEl.innerHTML = '<div style="display: flex; align-items: center; justify-content: center; height: 100%; background: rgb(var(--gray-light)); color: rgb(var(--gray)); border-radius: 12px; border: 2px solid rgba(201, 165, 123, 0.3);"><p>Failed to load Google Maps. Please check your API key.</p></div>';
					}
				};
				document.head.appendChild(script);
			} else {
				console.log('No Google Maps API key configured');
			}
		</script>

		<script define:vars={{ calendarEventCounts, snapshotsByDate }}>
			// Category filter functionality
			document.addEventListener('DOMContentLoaded', () => {
				console.log('Calendar event counts:', calendarEventCounts);
				console.log('Snapshots by date:', snapshotsByDate);
				console.log('Total event dates:', Object.keys(calendarEventCounts).length);

				const filterButtons = document.querySelectorAll('.category-filter button');
				const eventCards = document.querySelectorAll('.event-card');

				filterButtons.forEach(button => {
					button.addEventListener('click', () => {
						const category = button.dataset.category;

						// Toggle active state
						filterButtons.forEach(btn => btn.classList.remove('active'));
						button.classList.add('active');

						// Filter events
						eventCards.forEach(card => {
							if (category === 'all' || card.dataset.category === category) {
								card.classList.remove('hidden');
							} else {
								card.classList.add('hidden');
							}
						});
					});
				});

				// Calendar functionality
				let currentMonth = new Date().getMonth();
				let currentYear = new Date().getFullYear();

				// Helper function to create event card HTML
				function createEventCard(event) {
					return `
						<div class="event-card" data-category="${event.category}" data-event-date="${event.event_date}">
							<div class="event-header">
								<span class="category-badge ${event.category}">${event.category}</span>
								<span class="event-date-badge">${event.event_date}</span>
							</div>
							<h3 class="event-title">${event.title}</h3>
							<p class="event-description">${event.description}</p>
							<div class="event-footer">
								${event.location ? `<span class="event-location">📍 ${event.location}</span>` : ''}
								${event.link ? `<a href="${event.link}" target="_blank" rel="noopener noreferrer" class="event-link">Read more →</a>` : ''}
							</div>
						</div>
					`;
				}

				// Display snapshot events for a specific date
				function displaySnapshotEvents(dateStr, events) {
					// Hide "Today's Events" section
					const todaySection = document.querySelector('.today-section');
					if (todaySection) {
						todaySection.style.display = 'none';
					}

					// Hide category filter
					const categoryFilter = document.querySelector('.category-filter');
					if (categoryFilter) {
						categoryFilter.style.display = 'none';
					}

					// Hide all current event cards
					eventCards.forEach(card => card.style.display = 'none');

					// Create and insert snapshot header if not exists
					let snapshotSection = document.querySelector('.snapshot-section');
					if (!snapshotSection) {
						snapshotSection = document.createElement('div');
						snapshotSection.className = 'snapshot-section';
						snapshotSection.style.marginBottom = '2rem';

						// Insert after category filter or at beginning
						const eventsContent = document.querySelector('.events-content');
						if (categoryFilter) {
							categoryFilter.after(snapshotSection);
						} else if (todaySection) {
							todaySection.after(snapshotSection);
						} else if (eventsContent.firstChild) {
							eventsContent.insertBefore(snapshotSection, eventsContent.firstChild);
						}
					}

					// Build snapshot content
					const header = `
						<div class="snapshot-header" style="margin-bottom: 2rem; padding: 1.5rem; background: rgb(var(--gray-light)); border-radius: 12px; border: 2px solid var(--accent);">
							<h2 style="margin: 0 0 0.5rem 0; color: var(--accent);">Events Snapshot: ${dateStr}</h2>
							<p style="margin: 0 0 1rem 0; color: rgb(var(--gray)); font-size: 0.9rem;">${events.length} event(s) found on this date</p>
							<button id="back-to-current" style="padding: 0.5rem 1rem; background: var(--accent); color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">← Back to Current Events</button>
						</div>
					`;

					// Create event cards
					const eventsHtml = events.map(event => createEventCard(event)).join('');

					// Update snapshot section
					snapshotSection.innerHTML = header + eventsHtml;

					// Add back button handler
					document.getElementById('back-to-current').addEventListener('click', () => {
						// Hide snapshot section
						snapshotSection.style.display = 'none';

						// Show "Today's Events" section
						if (todaySection) {
							todaySection.style.display = 'block';
						}

						// Show category filter
						if (categoryFilter) {
							categoryFilter.style.display = 'flex';
						}

						// Show all event cards
						eventCards.forEach(card => card.style.display = 'block');
					});

					// Show snapshot section
					snapshotSection.style.display = 'block';

					// Scroll to snapshot section
					snapshotSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}

				// Filter current events by date
				function filterEventsByDate(dateStr) {
					filterButtons.forEach(btn => btn.classList.remove('active'));
					const allButton = document.querySelector('[data-category="all"]');
					if (allButton) allButton.classList.add('active');

					let firstMatchingCard = null;
					let matchedCount = 0;
					eventCards.forEach(card => {
						if (card.dataset.eventDate === dateStr) {
							card.classList.remove('hidden');
							if (!firstMatchingCard) firstMatchingCard = card;
							matchedCount++;
						} else {
							card.classList.add('hidden');
						}
					});

					console.log(`Filtered ${matchedCount} current event cards for ${dateStr}`);

					// Scroll to first matching event
					if (firstMatchingCard) {
						setTimeout(() => {
							firstMatchingCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
						}, 100);
					}
				}

				function renderCalendar(month, year) {
					const calendarGrid = document.getElementById('calendar-grid');
					const currentMonthEl = document.getElementById('current-month');

					// Clear calendar
					calendarGrid.innerHTML = '';

					// Set month name
					const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
						'July', 'August', 'September', 'October', 'November', 'December'];
					currentMonthEl.textContent = `${monthNames[month]} ${year}`;

					// Day headers
					const dayHeaders = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
					dayHeaders.forEach(day => {
						const header = document.createElement('div');
						header.className = 'calendar-day-header';
						header.textContent = day;
						calendarGrid.appendChild(header);
					});

					// First day of month
					const firstDay = new Date(year, month, 1).getDay();
					const daysInMonth = new Date(year, month + 1, 0).getDate();

					// Empty cells before first day
					for (let i = 0; i < firstDay; i++) {
						const emptyDay = document.createElement('div');
						emptyDay.className = 'calendar-day empty';
						calendarGrid.appendChild(emptyDay);
					}

					// Days of month
					const today = new Date();
					for (let day = 1; day <= daysInMonth; day++) {
						const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
						const dayEl = document.createElement('div');
						dayEl.className = 'calendar-day';

						// Check if today
						if (day === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
							dayEl.classList.add('today');
						}

						// Check if has snapshot (historical events)
						const hasSnapshot = snapshotsByDate[dateStr] && snapshotsByDate[dateStr] > 0;

						// Check if has events (from snapshots or active events)
						const eventCount = calendarEventCounts[dateStr] || 0;
						if (eventCount > 0) {
							if (hasSnapshot) {
								dayEl.classList.add('has-snapshot');
							} else {
								dayEl.classList.add('has-events');
							}
						}

						// Day number
						const dayNumber = document.createElement('span');
						dayNumber.className = 'calendar-day-number';
						dayNumber.textContent = day;
						dayEl.appendChild(dayNumber);

						// Event badge
						if (eventCount > 0) {
							const badge = document.createElement('span');
							badge.className = 'calendar-day-badge';
							badge.textContent = String(eventCount);
							dayEl.appendChild(badge);
						}

						// Click handler - load snapshot for this date
						dayEl.addEventListener('click', async (e) => {
							console.log('Calendar day clicked:', dateStr, 'eventCount:', eventCount);
							if (eventCount > 0) {
								// Try to load snapshot file for this date
								const snapshotUrl = `/events-data/${dateStr}.json`;

								try {
									const response = await fetch(snapshotUrl);
									if (response.ok) {
										const snapshotData = await response.json();
										const snapshotEvents = Object.values(snapshotData);
										console.log(`Loaded ${snapshotEvents.length} events from snapshot ${dateStr}`);

										// Replace events content with snapshot
										displaySnapshotEvents(dateStr, snapshotEvents);
									} else {
										// No snapshot, filter current events
										console.log('No snapshot found, filtering current events for:', dateStr);
										filterEventsByDate(dateStr);
									}
								} catch (err) {
									console.error('Failed to load snapshot:', err);
									// Fallback to filtering current events
									filterEventsByDate(dateStr);
								}
							}
						});

						calendarGrid.appendChild(dayEl);
					}
				}

				// Initial render
				renderCalendar(currentMonth, currentYear);

				// Navigation buttons
				document.getElementById('prev-month').addEventListener('click', () => {
					currentMonth--;
					if (currentMonth < 0) {
						currentMonth = 11;
						currentYear--;
					}
					renderCalendar(currentMonth, currentYear);
				});

				document.getElementById('next-month').addEventListener('click', () => {
					currentMonth++;
					if (currentMonth > 11) {
						currentMonth = 0;
						currentYear++;
					}
					renderCalendar(currentMonth, currentYear);
				});
			});
		</script>
	</head>
	<body>
		<Header />
		<main>
			<!-- Google Maps - Full Width -->
			<div id="map">
				{!GOOGLE_MAPS_API_KEY && (
					<div style="display: flex; align-items: center; justify-content: center; height: 100%; background: rgb(var(--gray-light)); color: rgb(var(--gray));">
						<p>Google Maps API key not configured. Events list below.</p>
					</div>
				)}
			</div>

			<div class="page-content">
				<header class="page-header">
					<h1>Lake County Events</h1>
					<p>Last Update: {lastUpdate}</p>
				</header>

				<!-- 3-column layout -->
				<div class="content-grid">
				<!-- Left sidebar - Trusted Sources -->
				<aside class="sidebar-left">
					<div class="sources-panel">
						<h2>Trusted Sources</h2>
						{sortedSources.length > 0 ? (
							sortedSources.map(source => (
								<div class="source-item">
									<a href={`https://${source.domain}`} target="_blank" rel="noopener noreferrer" class="source-link">
										<div class="source-domain">{source.domain}</div>
										<div class="source-count">{source.count} events</div>
									</a>
								</div>
							))
						) : (
							<p style="color: rgb(var(--gray)); font-size: 0.85rem;">No sources yet</p>
						)}
					</div>
				</aside>

				<!-- Center - Events list -->
				<div class="events-content">
					<!-- Today's Events Section -->
					<div class="today-section">
						<h2>Today's Events</h2>
						{todayEvents.length > 0 ? (
							todayEvents.map(event => (
								<div class="event-card" data-category={event.category} data-event-date={event.event_date}>
									<div class="event-header">
										<span class={`category-badge ${event.category}`}>{event.category}</span>
										<span class="event-date-badge">{event.event_date}</span>
									</div>
									<h3 class="event-title">{event.title}</h3>
									<p class="event-description">{event.description}</p>
									<div class="event-footer">
										{event.location && (
											<span class="event-location">📍 {event.location}</span>
										)}
										{event.link && (
											<a href={event.link} target="_blank" rel="noopener noreferrer" class="event-link">
												Read more →
											</a>
										)}
									</div>
								</div>
							))
						) : (
							<p class="today-empty">No events scheduled for today</p>
						)}
					</div>

					{/* Category Filter */}
					{allCategories.length > 0 && (
						<div class="category-filter">
							<button data-category="all" class="active">All</button>
							{allCategories.map((cat) => (
								<button data-category={cat}>{cat}</button>
							))}
						</div>
					)}

					{/* Future Events */}
					{futureEvents.length > 0 ? (
						futureEvents.map(event => (
							<div class="event-card" data-category={event.category} data-event-date={event.event_date}>
								<div class="event-header">
									<span class={`category-badge ${event.category}`}>{event.category}</span>
									<span class="event-date-badge">{event.event_date}</span>
								</div>
								<h3 class="event-title">{event.title}</h3>
								<p class="event-description">{event.description}</p>
								<div class="event-footer">
									{event.location && (
										<span class="event-location">📍 {event.location}</span>
									)}
									{event.link && (
										<a href={event.link} target="_blank" rel="noopener noreferrer" class="event-link">
											Read more →
										</a>
									)}
								</div>
							</div>
						))
					) : (
						<p class="no-events">No upcoming events. Check back later!</p>
					)}
				</div>

				<!-- Right sidebar - Calendar -->
				<aside class="sidebar-right">
					<div class="calendar-panel">
						<h2>Calendar</h2>
						<div class="calendar-nav">
							<button id="prev-month">‹</button>
							<span class="calendar-month" id="current-month"></span>
							<button id="next-month">›</button>
						</div>
						<div class="calendar-grid" id="calendar-grid">
							<!-- Calendar will be populated by JavaScript -->
						</div>
					</div>
				</aside>
			</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
